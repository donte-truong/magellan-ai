{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "partial"
      ]
    },
    "product": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "brand": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "brand"
      ],
      "additionalProperties": {}
    },
    "items": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "category": {
            "type": "string",
            "enum": [
              "component",
              "subassembly",
              "material",
              "packaging",
              "consumable",
              "software",
              "other"
            ]
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "material": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "manufacturer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "part_number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "parent_item_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "basis": {
            "type": "string",
            "enum": [
              "evidenced",
              "inferred",
              "guessed"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "sources": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "web_page"
                    },
                    "source_id": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "url": {
                      "type": "string",
                      "maxLength": 2000,
                      "format": "uri"
                    },
                    "title": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "quote": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "locator": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "type",
                    "source_id",
                    "url",
                    "title",
                    "quote",
                    "locator"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "web_page_unverified"
                    },
                    "source_id": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "url": {
                      "type": "string",
                      "maxLength": 2000,
                      "format": "uri"
                    },
                    "title": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "claimed_quote": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "type",
                    "source_id",
                    "url",
                    "title",
                    "claimed_quote",
                    "note"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "search_snippet"
                    },
                    "url": {
                      "type": "string",
                      "maxLength": 2000,
                      "format": "uri"
                    },
                    "title": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "snippet": {
                      "type": "string",
                      "maxLength": 16000
                    },
                    "query": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "type",
                    "url",
                    "title",
                    "snippet",
                    "query"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "image_analysis"
                    },
                    "source_id": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "type",
                    "source_id",
                    "note"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "user_input"
                    },
                    "field": {
                      "type": "string",
                      "enum": [
                        "description",
                        "url",
                        "image_url",
                        "company"
                      ]
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "type",
                    "field",
                    "note"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "model_knowledge"
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "type",
                    "note"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "quantity",
          "unit",
          "material",
          "manufacturer",
          "part_number",
          "parent_item_id",
          "notes",
          "basis",
          "confidence",
          "sources"
        ],
        "additionalProperties": {}
      }
    },
    "sources": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri"
          }
        },
        "required": [
          "id",
          "url"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "id",
    "status",
    "product",
    "items",
    "sources"
  ],
  "additionalProperties": {}
}
