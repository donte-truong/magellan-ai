# Model backend for both graph research and BOM estimation: openai | openrouter.
RESEARCH_MODEL_PROVIDER=openai
OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional separate reviewer model. Changing either model requires explicit tariffs below.
# OPENAI_VERIFIER_MODEL=gpt-5.4-mini
# To use OpenRouter, set RESEARCH_MODEL_PROVIDER=openrouter and configure:
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_VERIFIER_MODEL=openai/gpt-4o-mini
# Strict schema enforcement is the default. For JSON-only providers such as
# minimax/minimax-m3:free, use json_object; local schema validation still applies.
# OPENROUTER_OUTPUT_MODE=json_schema
# OpenRouter always requires both tariffs below (even for free models: use 0).
# They also bound router prompt/completion pricing. Use models with structured
# outputs; image-based BOM requests additionally require vision support.
# USD cents per million tokens; set conservative upper bounds for BOTH selected models.
# RESEARCH_INPUT_CENTS_PER_MILLION=75
# RESEARCH_OUTPUT_CENTS_PER_MILLION=450
# Conservative per-request reservations, not a provider invoice.
RESEARCH_SEARCH_COST_MINOR=2
RESEARCH_EXTRACT_COST_MINOR=2
# Required only for HTTP API. CLI does not require a workspace token.
RESEARCH_API_TOKEN=
# Single long-lived local Node process with writable disk; not serverless.
# RESEARCH_RUNS_DIR=./runs
