# Local API: Authorization: Bearer dev-token
ENVIRONMENT=development
DATABASE_URL=sqlite:///./magellan.db
WORKSPACE_TOKENS={"dev-token":"demo"}
CORS_ORIGINS=["http://localhost:5173"]
AUTO_CREATE_SCHEMA=true
EMBEDDED_WORKER=true
WORKER_SLOTS=3

# fixture supports Raspberry Pi 5 and uploaded BOMs without network calls.
# To research arbitrary products, select live, supply Tavily credentials,
# and configure either OpenAI or OpenRouter below.
RESEARCH_PROVIDER=fixture
# Curated fixture depth: 1 is the original three-component example; 2 adds the BCM2712's
# parts so multi-hop chains can be exercised without keys.
FIXTURE_DEPTH=1
TAVILY_API_KEY=
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
# Model roles: extraction (volume) uses the base model; the verifier and planner (judgment)
# fall back to it when unset. The planner falls back to the verifier.
OPENAI_VERIFIER_MODEL=
OPENAI_PLANNER_MODEL=
# For free models, set LLM_PROVIDER=openrouter. No OpenAI key is required.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Empty uses OPENROUTER_MODEL for the independent verification pass too.
OPENROUTER_VERIFIER_MODEL=
OPENROUTER_PLANNER_MODEL=
# json_schema requires a compatible model. For models offering only JSON
# mode (such as minimax/minimax-m3:free), use json_object; local validation remains.
OPENROUTER_RESPONSE_FORMAT=json_schema
PROVIDER_TIMEOUT_SECONDS=30

# Optional operator billing estimates, in USD cents. When absent, live usage
# omits cost_minor and reports that cost is unknown. Setting both token rates
# also permits paid OpenRouter vendor/model IDs, with the rates as price ceilings.
# INPUT_TOKEN_COST_PER_MILLION_MINOR=
# OUTPUT_TOKEN_COST_PER_MILLION_MINOR=
# SEARCH_COST_MINOR=
# PRODUCTION_DATA_PATH=/absolute/path/to/production.json
